# No API key required. No hosted provider fallback.
LC_AI_PROVIDER=ollama
LC_MODEL=gemma3:4b
LC_OLLAMA_URL=http://127.0.0.1:11434
LC_WHISPER_URL=http://127.0.0.1:8080/inference
LC_DATABASE_PATH=data/language-conversation.sqlite3
# start.ps1 generates a private persistent data/auth-secret if omitted.
# LC_AUTH_SECRET=<random 32+ characters; never commit>
LC_COOKIE_SECURE=1
LC_ALLOWED_ORIGINS=https://192.168.0.10:8443

# Optional: Pages-to-PC shared secret, required only for external-test edge deployment.
# LC_EDGE_SECRET=<random 48+ bytes; never commit>
